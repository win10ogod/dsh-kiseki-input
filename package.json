    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "runtime",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
