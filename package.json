{
  "name": "dsh-kiseki-input",
  "version": "0.2.2",
  "description": "Kiseki Input executable-backed desktop tools for DeepSeek Harness",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/win10ogod/dsh-kiseki-input.git"
  },
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
